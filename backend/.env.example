# Required in production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-in-production

# Optional: OAuth client ID (Google Cloud console -> Credentials -> OAuth
# client ID -> Web application). Add your origins under "Authorized JavaScript
# origins": http://localhost:5173 for development, your deployed URL for live.
# Blank turns the Google button off; it is a public value, not a secret.
GOOGLE_CLIENT_ID=

# Any OpenAI-compatible chat endpoint. Pick ONE block.
# --- Groq (free tier) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# --- Gemini (free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# Where SQLite + ChromaDB files live
DATA_DIR=./data

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Embedding batch size. 1 is fastest on CPU: batched texts are padded to the
# longest in the batch, and that wasted compute costs more than the per-call
# overhead it saves. Measured on a 143-page PDF: 4.5s at 1 vs 19s at 256,
# producing identical vectors. Raise it only if you move to a GPU.
# EMBEDDING_BATCH_SIZE=1

# Optional RAG tuning (defaults shown)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4
# MAX_DISTANCE=0.65

# Optional exam-generation tuning (defaults shown)
# Writing a whole test takes much longer than answering one question.
# EXAM_TIMEOUT_SECONDS=180
# EXAM_MAX_QUESTIONS=30
# How much of the document is put in front of the model, in characters.
# EXAM_CONTEXT_CHARS=24000

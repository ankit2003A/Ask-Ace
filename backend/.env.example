# Required in production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-in-production

# Any OpenAI-compatible chat endpoint. Pick ONE block.
# --- Groq (free tier) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# --- Gemini (free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# Where SQLite + ChromaDB files live
DATA_DIR=./data

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Optional RAG tuning (defaults shown)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4
# MAX_DISTANCE=0.65
